<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension
         point="org.eclipse.ui.navigator.viewer">
      <viewerContentBinding
            viewerId="org.eclipse.ui.navigator.ProjectExplorer">
         <includes>
            <contentExtension
                  pattern="org.eclipse.m2m.qvt.oml.bbox.ui.blackboxContent">
            </contentExtension>
         </includes>
      </viewerContentBinding>
   </extension>

   <extension
         point="org.eclipse.ui.navigator.navigatorContent">
      <navigatorContent
            activeByDefault="true"
            contentProvider="org.eclipse.m2m.internal.qvt.oml.bbox.ui.navigator.BlackboxNavigatorContentProvider"
            id="org.eclipse.m2m.qvt.oml.bbox.ui.blackboxContent"
            labelProvider="org.eclipse.m2m.internal.qvt.oml.bbox.ui.navigator.BlackboxNavigatorLabelProvider"
            name="%blackboxNavigatorContentName"
            priority="normal">
         <triggerPoints>
            <or>
               <adapt
                     type="org.eclipse.core.resources.IProject">
                  <test
                        property="org.eclipse.core.resources.projectNature"
                        value="org.eclipse.m2m.qvt.oml.project.QVTONature">
                  </test>
               </adapt>
            </or>
         </triggerPoints>
         <possibleChildren>
            <or>
               <instanceof
                     value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.navigator.BlackboxRootNode">
               </instanceof>
               <instanceof
                     value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.navigator.BlackboxLoadingNode">
               </instanceof>
               <instanceof
                     value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.discovery.BlackboxUnitInfo">
               </instanceof>
               <instanceof
                     value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.discovery.BlackboxModuleInfo">
               </instanceof>
               <instanceof
                     value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.discovery.BlackboxOperationInfo">
               </instanceof>
               <instanceof
                     value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.discovery.BlackboxDiagnosticInfo">
               </instanceof>
            </or>
         </possibleChildren>
         <actionProvider
               class="org.eclipse.m2m.internal.qvt.oml.bbox.ui.navigator.BlackboxNavigatorActionProvider"
               id="org.eclipse.m2m.qvt.oml.bbox.ui.blackboxScopeActions">
            <enablement>
               <or>
                  <instanceof
                        value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.navigator.BlackboxRootNode">
                  </instanceof>
                  <instanceof
                        value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.discovery.BlackboxUnitInfo">
                  </instanceof>
                  <instanceof
                        value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.discovery.BlackboxModuleInfo">
                  </instanceof>
                  <instanceof
                        value="org.eclipse.m2m.internal.qvt.oml.bbox.ui.discovery.BlackboxOperationInfo">
                  </instanceof>
               </or>
            </enablement>
         </actionProvider>
      </navigatorContent>
   </extension>

</plugin>
